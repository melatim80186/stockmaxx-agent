# StockMaxx agent — copy to .env and fill in. NEVER commit a real .env.
# The agent key is a fresh throwaway operator key (testnet only). It can
# trade inside the vault guardrails but CANNOT withdraw funds.

# Base Sepolia (chain 84532) or Anvil local (31337, --demo)
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
EXPLORER_URL=https://sepolia.basescan.org

# Operator private key (0x...). Generate with: cast wallet new
AGENT_PRIVATE_KEY=

# Filled automatically from contracts/deployments/<chainId>.json after deploy.
# Override here only if deploying manually.
# USDC_ADDRESS=
# ORACLE_ADDRESS=
# EXCHANGE_ADDRESS=
# VAULT_ADDRESS=

# Strategy knobs
TRADE_USD=20
MAX_POSITION_USD=400
CYCLE_SECONDS=300
PORT=8080
